generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum Roles{
  STUDENT
  TUTOR
  ADMIN
}


enum AuthProvider {
  CREDENTIALS
  GOOGLE
  APPLE
}


enum SignupIntent {
  STUDENT
  TUTOR
}


model User {
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                    String?
  email                   String                    @unique
  phone                   String?                   @unique
  password                String?
  avatar                  String?
  role                    Roles                     @default(STUDENT)

  signupIntent            SignupIntent              @default(STUDENT)


  provider                AuthProvider              @default(CREDENTIALS)

  isEmailVerified         Boolean                   @default(false)

  isActive                Boolean                   @default(true)
  profileCompleted        Boolean                   @default(false)

  hashedRefreshToken      String?
  refreshTokenExpiresAt   DateTime?

  student                 Student?
  tutor                   Tutor?

  orders                  Order[]
  transactions            Transaction[]
  wishlists               Wishlist[]


  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Student{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  user                    User                      @relation(fields: [userId], references: [id])
  userId                  String                    @unique @db.ObjectId

  levelId                 String?                   @db.ObjectId
  level                   Level?                    @relation(fields: [levelId], references: [id])

  boardId                 String?                   @db.ObjectId
  board                   Board?                    @relation(fields: [boardId], references: [id])

  studentSubjects         StudentSubject[]
  
  preferredLanguageId     String?                   @db.ObjectId
  preferredLanguage       Language?                 @relation(fields: [preferredLanguageId], references: [id])

  goals                   String[]                  @default([])

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  tasks                   Task[]
  enrollments             ClassEnrollment[]
  attendances             Attendance[]
  reviews                 Review[]
}

enum TutorStatus {
  PENDING_REVIEW   // form submitted, waiting for admin
  APPROVED         // verified tutor
  REJECTED         // rejected, can re-apply
  SUSPENDED        // blocked by admin
}


model Tutor{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  user                    User                      @relation(fields: [userId], references: [id])
  userId                  String                    @unique @db.ObjectId

  title                   String?
  yearsOfExp              Float?
  bio                     String?
  qualification           String[]
  demoLinks               String[]

  tutorStatus             TutorStatus               @default(PENDING_REVIEW)

  rating                  Float                     @default(0.0)
  totalStudents           Int                       @default(0)

  tutorSubjects           TutorSubject[]
  tutorLevels             TutorLevel[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  classes                 TuitionClass[]
  reviews                 Review[]
}



enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}


model Subject{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  name                    String
  slug                    String                    @unique
  icon                    String?
  priority                Int                       @unique
  status                  Status                    @default(ACTIVE)

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status])
  classes                 TuitionClass[]
  studentSubjects         StudentSubject[]
  tutorSubjects           TutorSubject[]
}


model Level{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  name                    String
  slug                    String                    @unique
  icon                    String?
  priority                Int                       @unique
  status                  Status                    @default(ACTIVE)

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status])
  classes                 TuitionClass[]
  students                Student[]
  tutorLevels             TutorLevel[]
}


model Board{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  name                    String
  slug                    String                    @unique
  icon                    String?
  priority                Int                       @unique
  status                  Status                    @default(ACTIVE)

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status])
  classes                 TuitionClass[]
  students                Student[]
}


model Language{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  name                    String
  slug                    String                    @unique
  icon                    String?
  priority                Int                       @unique
  status                  Status                    @default(ACTIVE)

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status])
  classes                 TuitionClass[]
  students                Student[]
}


model StudentSubject {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId

  studentId  String   @db.ObjectId
  subjectId  String   @db.ObjectId

  student    Student  @relation(fields: [studentId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([studentId, subjectId])
  @@index([studentId])
  @@index([subjectId])
}


model TutorSubject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  tutorId   String   @db.ObjectId
  subjectId String   @db.ObjectId

  tutor     Tutor    @relation(fields: [tutorId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tutorId, subjectId])
  @@index([tutorId])
  @@index([subjectId])
}


model TutorLevel {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId

  tutorId  String   @db.ObjectId
  levelId  String   @db.ObjectId

  tutor    Tutor    @relation(fields: [tutorId], references: [id])
  level    Level    @relation(fields: [levelId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tutorId, levelId])
  @@index([tutorId])
  @@index([levelId])
}



//Task System
enum TaskType{
  PRIVATE
  ASSIGNED
}

enum TaskStatus{
  TODO
  ONGOING
  COMPLETED
}

enum TaskCommentType{
  HELP_REQUEST
  TUTOR_REPLY
  TUTOR_REMARK
  TUTOR_FEEDBACK
}

model ClassTask {
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  classId                 String                    @db.ObjectId
  tutorId                 String                    @db.ObjectId

  title                   String
  description             String?
  
  dueDate                 DateTime?

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  tasks                   Task[]                    @relation("ClassTaskToStudentTasks")

  @@index([classId])
  @@index([tutorId])
}


model Task{
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId

  studentId               String                    @db.ObjectId
  student                 Student                   @relation(fields: [studentId], references: [id])

  title                   String
  description             String?

  dueDate                 DateTime?

  type                    TaskType                  @default(PRIVATE)
  status                  TaskStatus                @default(TODO)

  // Only for CLASS_ASSIGNED tasks
  classTaskId             String?                   @db.ObjectId
  classTask               ClassTask?                @relation("ClassTaskToStudentTasks",fields: [classTaskId],references: [id])

  classId                 String?                   @db.ObjectId
  tutorId                 String?                   @db.ObjectId

  // Indicates tutor override (rejected proof)
  overriddenByTutor       Boolean                   @default(false)

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  proofs                  TaskProof[]
  comments                TaskComment[]

  @@index([studentId])
  @@index([classTaskId])
  @@index([classId])
  @@index([tutorId])
  @@index([status])
  @@index([type])
  @@index([studentId, status]) // dashboard filters
}


model TaskProof {
  id                      String                      @id @default(auto()) @map("_id") @db.ObjectId

  taskId                  String                      @db.ObjectId
  task                    Task                        @relation(fields: [taskId], references: [id])

  studentId               String                      @db.ObjectId

  fileUrl                 String
  note                    String?

  createdAt               DateTime                    @default(now())

  @@index([taskId])
}


model TaskComment {
  id                      String                      @id @default(auto()) @map("_id") @db.ObjectId

  taskId                  String                      @db.ObjectId
  task                    Task                        @relation(fields: [taskId], references: [id])

  authorId                String                      @db.ObjectId

  type                    TaskCommentType
  message                 String

  createdAt               DateTime                    @default(now())

  @@index([taskId])
  @@index([type])
}



// Tuition Class Functionality
enum ClassType {
  GROUP
  PRIVATE
}

enum ClassVisibility {
  PUBLIC
  PRIVATE
}

enum ClassStatus{
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model TuitionClass{
  id                      String                      @id @default(auto()) @map("_id") @db.ObjectId

  tutorId                 String                      @db.ObjectId
  tutor                   Tutor                       @relation(fields: [tutorId], references: [id])

  boardId                 String?                     @db.ObjectId
  subjectId               String                      @db.ObjectId
  levelId                 String                      @db.ObjectId
  languageId              String?                     @db.ObjectId


  title                   String
  seo_name                String                      @unique
  description             String

  syllabus                Json

  previewImg              String?
  previewVdo              String?

  type                    ClassType                   @default(GROUP)
  visibility              ClassVisibility             @default(PUBLIC)
  status                  ClassStatus                 @default(DRAFT)

  startDate               DateTime
  endDate                 DateTime
  
  joiningStartDate        DateTime
  joiningEndDate          DateTime

  daysOfWeek              DayOfWeek[]
  startTime               String?
  durationMin             Int?
  timeZone                String?

  capacity                Int                         @default(1)

  isPaid                  Boolean                     @default(false)
  price                   Float?
  currency                String?

  totalEnrolment          Int?                        @default(0)


  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  board                   Board?                      @relation(fields: [boardId], references: [id])
  subject                 Subject                     @relation(fields: [subjectId], references: [id])
  level                   Level                       @relation(fields: [levelId], references: [id])
  language                Language?                   @relation(fields: [languageId], references: [id])
  enrollments             ClassEnrollment[]
  sessions                Session[]
  resources               Resource[]
  reviews                 Review[]

  wishlists               Wishlist[]

  @@index([tutorId])
  @@index([type, status])
}


model ClassEnrollment {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId

  classId           String              @db.ObjectId
  studentId         String              @db.ObjectId

  orderId           String?              @db.ObjectId

  enrolledAt        DateTime            @default(now())

  klass             TuitionClass        @relation(fields: [classId], references: [id])
  student           Student             @relation(fields: [studentId], references: [id])

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([classId, studentId])
}


enum SessionType{
  REGULAR
  EXTRA
  DOUBT
}

enum SessionStatus{
  PENDING_TUTOR_APPROVAL   // PRIVATE
  SCHEDULED
  CANCELLED_BY_TUTOR
  CANCELLED_BY_STUDENT
  NO_SHOW_STUDENT
  COMPLETED
}


model Session {
  id                      String           @id @default(auto()) @map("_id") @db.ObjectId

  classId                 String           @db.ObjectId
  tutorId                 String           @db.ObjectId
  studentId               String?          @db.ObjectId

  klass                   TuitionClass     @relation(fields: [classId], references: [id])
  attendances             Attendance[]

  date                    DateTime
  startTime               String
  durationMin             Int

  sessionType             SessionType
  status                  SessionStatus
  createdBy               String
  meetingLink             String?

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([classId])
  @@index([tutorId])
  @@index([studentId])
  @@index([date])
}



enum AttendanceStatus{
  PRESENT
  ABSENT
  LEAVE
}

model Attendance{
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId

  sessionId             String              @db.ObjectId
  session               Session             @relation(fields: [sessionId], references: [id])

  studentId             String              @db.ObjectId
  student               Student             @relation(fields: [studentId], references:[id])

  status                AttendanceStatus
  markedBy              String
  markedAt              DateTime            @default(now())

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}


enum FileType {
  PDF
  VIDEO
  IMAGE
  DOC
  PPT
  OTHER
}

model Resource{
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId

  title                 String
  seo_name              String              @unique
  description           String?

  classId               String              @db.ObjectId
  klass                 TuitionClass        @relation(fields: [classId], references:[id])

  type                  FileType
  size                  Int

  fileUrl               String

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([classId])
}


model TutorAvailability {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId

  tutorId               String          @db.ObjectId
 
  dayOfWeek             DayOfWeek
  startTime             String    // "09:00"
  endTime               String    // "12:00"
  timeZone              String

  isActive              Boolean         @default(true)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([tutorId])
  @@index([dayOfWeek])
}


model TutorTimeOff {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId

  tutorId           String             @db.ObjectId

  date              DateTime  // 2025-02-10
  startTime         String    // "10:30"
  endTime           String    // "11:30"

  reason            String?
  createdAt         DateTime            @default(now())

  @@index([tutorId, date])
}


model TutorLeave {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId

  tutorId           String              @db.ObjectId

  startDate         DateTime
  endDate           DateTime

  reason            String?
  createdAt         DateTime            @default(now())

  @@index([tutorId, startDate, endDate])
}


enum PriceOn{
  CLASS
  RESOURCE
}

enum PriceType{
  PERCENTAGE
  FIXED
}

model CommissionSetting {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId

  appliesTo             PriceOn           @default(CLASS)
  type                  PriceType         @default(PERCENTAGE)
  value                 Float             @default(0.0)

  status                Status            @default(ACTIVE)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([appliesTo, type])
  @@index([status])
}



model TaxSetting {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId

  name              String
  value             Float               @default(0.0)
  status            Status              @default(ACTIVE)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}


model Coupon {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId

  code                    String            @unique
  description             String?

  discountType            PriceType
  discountValue           Float

  appliesTo               PriceOn
  classId                 String?           @db.ObjectId
  resourceId              String?           @db.ObjectId

  minOrderValue           Float?
  maxDiscount             Float?

  usageLimit              Int?
  perUserLimit            Int?

  startsAt                DateTime?
  endsAt                  DateTime?

  status                  Status            @default(ACTIVE)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}


enum RedeemedStatus{
  RESERVED
  REDEEMED
  RELEASED
}

model CouponRedemption {
  id                        String          @id @default(auto()) @map("_id") @db.ObjectId

  couponId                  String          @db.ObjectId
  userId                    String          @db.ObjectId

  orderId                   String          @db.ObjectId
  order                     Order           @relation(fields: [orderId], references: [id])

  discountApplied           Float

  status                    RedeemedStatus
  redeemedAt                DateTime?

  createdAt                 DateTime        @default(now())

  @@index([couponId, userId])
  @@unique([orderId])
}


enum SeatStatus{
  ACTIVE
  CONFIRMED
  EXPIRED
}

model SeatReservation{
  id              String              @id @default(auto()) @map("_id") @db.ObjectId

  classId         String              @db.ObjectId
  userId          String              @db.ObjectId

  expiredAt       DateTime?
  status          SeatStatus

  createdAt       DateTime            @default(now())

  @@unique([classId, userId, status])
}


enum ProductType{
  CLASS
  RESOURCE
}

enum OrderStatus{
  PENDING
  PAID
  FAILED
  CANCELLED
}


model OrderCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  year      Int
  seq       Int      @default(0)

  @@unique([year])
}

model Order{
  id                      String          @id @default(auto()) @map("_id") @db.ObjectId

  userId                  String          @db.ObjectId
  user                    User            @relation(fields: [userId], references: [id])

  orderNo                 String

  productType             ProductType
  productId               String          @db.ObjectId

  basePrice               Float

  commissionAmount        Float

  tax                     Float
  taxAmount               Float

  discountAmount          Float?

  totalAmount             Float

  couponId                String?          @db.ObjectId


  status                  OrderStatus

  couponRedemption        CouponRedemption?
  transactions            Transaction[]


  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}


enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentType {
  PAYMENT
  REFUND
}


model Transaction {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId

  orderId           String          @db.ObjectId
  order             Order           @relation(fields: [orderId], references: [id])

  userId            String          @db.ObjectId
  user              User            @relation(fields: [userId], references: [id])

  provider          PaymentProvider
  type              PaymentType     @default(PAYMENT)

  amount            Float
  currency          String          @default("INR")

  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?

  status            PaymentStatus

  failureReason     String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([providerPaymentId])
}



model Review {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  studentId     String   @db.ObjectId
  tutorId       String   @db.ObjectId
  klassId       String   @db.ObjectId
  enrollmentId  String   @unique @db.ObjectId

  status        Status   @default(INACTIVE)

  rating        Int
  reviewText    String?

  tutor         Tutor         @relation(fields: [tutorId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  klass         TuitionClass  @relation(fields: [klassId], references: [id])

  createdAt     DateTime      @default(now())
}


model Wishlist {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId

  userId                String          @db.ObjectId
  productId             String          @db.ObjectId

  user                  User            @relation(fields: [userId], references: [id])
  product               TuitionClass    @relation(fields: [productId], references: [id])

  createdAt             DateTime        @default(now())

  @@unique([userId, productId])
}
